  logits[cbind(seq_len(n), as.integer(y))] <-
    logits[cbind(seq_len(n), as.integer(y))] + c(3, 1.5, 1)[as.integer(y)]
  p <- exp(logits) / rowSums(exp(logits))
  colnames(p) <- levels(y)
  list(p = p, y = y)
}
cal <- sim(1000)
test <- sim(500)

sel <- selective_fit(cal$p, cal$y, strategy = "class_conditional")
